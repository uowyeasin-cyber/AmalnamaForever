rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == 'uowyeasin@gmail.com';
    }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function approved() {
      return isAdmin() || (signedIn() && exists(memberDoc()) && get(memberDoc()).data.status == 'approved');
    }
    function txt(t, max) { return t is string && t.size() > 0 && t.size() <= max; }
    function own() { return request.resource.data.uid == request.auth.uid; }
    // guests (anonymous sign-in) may join and chat; posting and calls need a real (Google) account
    function realAccount() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function cfgDoc() { return /databases/$(database)/documents/config/community; }
    function chatLocked() { return exists(cfgDoc()) && get(cfgDoc()).data.get('chatLocked', false) == true; }

    // Join requests / membership. Only the person and the admins can read it.
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','email','photo','status','requestedAt','country','lang','intro'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.requestedAt == request.time
        && txt(request.resource.data.name, 60);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photo','lang','country','intro','lastSeen']));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status != 'blocked');
    }

    // Community settings (welcome text etc.)
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Posts
    match /posts/{pid} {
      allow read: if approved();
      allow create: if approved() && own() && realAccount()
        && request.resource.data.keys().hasOnly(['uid','name','photo','text','createdAt','announce','likes','pinned','bg','image','video'])
        && (txt(request.resource.data.text, 3000)
            || (request.resource.data.text == '' && (request.resource.data.get('image', '') != '' || request.resource.data.get('video', null) != null)))
        && (request.resource.data.get('video', null) == null || (request.resource.data.video is map
            && request.resource.data.video.keys().hasOnly(['n','mime','size','thumb','dur'])
            && request.resource.data.video.n is int && request.resource.data.video.n <= 40
            && request.resource.data.video.get('thumb', '') is string && request.resource.data.video.get('thumb', '').size() <= 200000))
        && request.resource.data.get('image', '') is string && request.resource.data.get('image', '').size() <= 900000
        && request.resource.data.get('bg', 0) is int && request.resource.data.get('bg', 0) >= 0 && request.resource.data.get('bg', 0) < 8
        && request.resource.data.createdAt == request.time
        && request.resource.data.likes.size() == 0
        && ((request.resource.data.announce == false && request.resource.data.pinned == false) || isAdmin());
      allow update: if isAdmin()
        || (approved() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited'])
            && txt(request.resource.data.text, 3000))
        || (approved()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && request.resource.data.likes.toSet().difference(resource.data.likes.toSet()).hasOnly([request.auth.uid])
            && resource.data.likes.toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid]));
      allow delete: if isAdmin() || (approved() && resource.data.uid == request.auth.uid);

      match /comments/{cid} {
        allow read: if approved();
        allow create: if approved() && own()
          && request.resource.data.keys().hasOnly(['uid','name','photo','text','createdAt'])
          && txt(request.resource.data.text, 1000)
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin() || (approved() && resource.data.uid == request.auth.uid);
      }
    }

    // Group chat
    match /messages/{mid} {
      allow read: if approved();
      allow create: if approved() && own() && (isAdmin() || !chatLocked())
        && request.resource.data.keys().hasOnly(['uid','name','photo','text','createdAt'])
        && txt(request.resource.data.text, 1000)
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() || (approved() && resource.data.uid == request.auth.uid);
    }

    // Stories: text, photo or video that members see for 24 hours
    match /stories/{sid} {
      allow read: if approved();
      allow create: if approved() && own() && realAccount()
        && request.resource.data.keys().hasOnly(['uid','name','photo','type','text','bg','image','media','createdAt'])
        && request.resource.data.type in ['text','image','video']
        && request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 300
        && (request.resource.data.type != 'text' || txt(request.resource.data.text, 300))
        && request.resource.data.get('image', '') is string && request.resource.data.get('image', '').size() <= 900000
        && (request.resource.data.type != 'video' || (request.resource.data.media is map && request.resource.data.media.n is int && request.resource.data.media.n <= 30
            && request.resource.data.media.get('thumb', '') is string && request.resource.data.media.get('thumb', '').size() <= 200000))
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() || (approved() && resource.data.uid == request.auth.uid);
    }
    // Pieces of post and story videos (each piece fits in one document)
    match /blobs/{bid} {
      allow read: if approved();
      allow create: if approved() && own() && realAccount()
        && request.resource.data.keys().hasOnly(['uid','d','i','n','ref','mime','createdAt'])
        && request.resource.data.d is string && request.resource.data.d.size() <= 800000
        && request.resource.data.n is int && request.resource.data.n <= 40
        && bid == request.resource.data.ref + '_' + string(request.resource.data.i)
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() || (approved() && (resource == null || resource.data.uid == request.auth.uid));
    }

    // Public profile inside the community: name, photo, about. Only approved members can see it.
    match /profiles/{uid} {
      allow read: if approved();
      allow create, update: if approved() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','photo','about','updatedAt','lastSeen'])
        && request.resource.data.uid == uid
        && txt(request.resource.data.name, 40)
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 200000
        && request.resource.data.get('about', '') is string && request.resource.data.get('about', '').size() <= 140;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // One-to-one chats. Only the two people in a chat can read or write it (not even the admin).
    function chatPath(cid) { return /databases/$(database)/documents/chats/$(cid); }
    function inChat(cid) { return signedIn() && exists(chatPath(cid)) && request.auth.uid in get(chatPath(cid)).data.members; }
    function isMedia(t) { return t in ['image','video','audio','file']; }
    function expired(d) { return d.createdAt < request.time - duration.value(30, 'd'); }
    function isGroup(d) { return d.get('group', false) == true; }
    match /chats/{cid} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      // WhatsApp-style groups: anyone approved can make one; the creator is its first admin
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['members','updatedAt','last','read','typing','cleared','group','name','photo','admins','createdBy'])
        && request.resource.data.group == true
        && !cid.matches('.*_.*')
        && request.resource.data.members is list && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 64
        && request.auth.uid in request.resource.data.members
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && txt(request.resource.data.name, 50)
        && request.resource.data.get('photo', '') is string && request.resource.data.get('photo', '').size() <= 200000;
      // group admins manage name, photo, members and admins
      allow update: if approved() && isGroup(resource.data) && request.auth.uid in resource.data.admins
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photo','members','admins','updatedAt','last','read','typing','cleared'])
        && request.resource.data.members is list && request.resource.data.members.size() <= 64
        && request.resource.data.admins is list && request.resource.data.admins.size() >= 1
        && request.resource.data.members.hasAll(request.resource.data.admins)
        && txt(request.resource.data.name, 50)
        && request.resource.data.get('photo', '') is string && request.resource.data.get('photo', '').size() <= 200000;
      // any member may leave a group
      allow update: if signedIn() && isGroup(resource.data) && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','updatedAt'])
        && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]);
      allow delete: if signedIn() && isGroup(resource.data) && request.auth.uid in resource.data.admins;
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['members','updatedAt','last','read','typing','cleared'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.members[0]))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.members[1]));
      allow update: if approved() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','last','read','typing','cleared']);

      match /messages/{mid} {
        allow read: if inChat(cid);
        allow create: if approved() && inChat(cid) && own()
          && request.resource.data.keys().hasOnly(['uid','type','text','media','createdAt','call','reply'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.type in ['text','image','video','audio','file','call','sys']
          && request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 4000
          && (request.resource.data.type != 'text' || txt(request.resource.data.text, 4000));
        allow delete: if inChat(cid) && (resource.data.uid == request.auth.uid || (isMedia(resource.data.type) && expired(resource.data)));
      }
      // media is stored in pieces and can only be opened for 30 days
      match /blobs/{bid} {
        allow read: if inChat(cid) && !expired(resource.data);
        allow create: if approved() && inChat(cid) && own()
          && request.resource.data.keys().hasOnly(['uid','d','i','n','mid','mime','createdAt'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 800000
          && request.resource.data.createdAt == request.time;
        allow delete: if inChat(cid) && (resource == null || resource.data.uid == request.auth.uid || expired(resource.data));
      }
    }

    // Web-push addresses of a person's phones/computers, so calls and messages can ring when the app is closed
    match /push/{uid} {
      allow read: if approved();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['subs','updatedAt'])
        && request.resource.data.subs is list && request.resource.data.subs.size() <= 5;
    }

    // Group voice / video calls: a "room" per call; every pair of people connects directly (mesh, up to 8)
    function roomPath(rid) { return /databases/$(database)/documents/rooms/$(rid); }
    function inRoom(rid) { return signedIn() && request.auth.uid in get(roomPath(rid)).data.members; }
    match /rooms/{rid} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if approved() && realAccount() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['chat','type','by','members','in','active','createdAt','name'])
        && request.resource.data.type in ['audio','video']
        && request.resource.data.createdAt == request.time
        && request.resource.data.active == true
        && request.resource.data.in == [request.auth.uid]
        && request.resource.data.members == get(chatPath(request.resource.data.chat)).data.members
        && request.auth.uid in request.resource.data.members;
      allow update: if realAccount() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['in','active','endedAt'])
        && request.resource.data.in.toSet().difference(resource.data.in.toSet()).hasOnly([request.auth.uid])
        && resource.data.in.toSet().difference(request.resource.data.in.toSet()).hasOnly([request.auth.uid])
        && request.resource.data.in.size() <= 8;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      match /peers/{pid} {
        allow read, delete: if inRoom(rid);
        allow create: if realAccount() && inRoom(rid) && request.resource.data.from == request.auth.uid
          && request.resource.data.keys().hasOnly(['from','to','offer','createdAt'])
          && request.resource.data.to in get(roomPath(rid)).data.members;
        allow update: if signedIn() && request.auth.uid == resource.data.to
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']);
        match /ice/{iid} {
          allow read, delete: if inRoom(rid);
          allow create: if inRoom(rid) && request.resource.data.by == request.auth.uid
            && request.resource.data.keys().hasOnly(['by','c','t']);
        }
      }
    }

    // Voice / video call signalling (the call itself goes directly between the two phones)
    function callPath(id) { return /databases/$(database)/documents/calls/$(id); }
    function inCall(id) { return signedIn() && request.auth.uid in [get(callPath(id)).data.from, get(callPath(id)).data.to]; }
    match /calls/{id} {
      allow read: if signedIn() && (resource == null || request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if approved() && realAccount() && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from','to','type','status','offer','createdAt','chat'])
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['audio','video']
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to));
      allow update: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer','endedAt','acceptedAt']);
      allow delete: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      match /ice/{iid} {
        allow read: if inCall(id);
        allow create: if inCall(id) && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['by','c','t']);
        allow delete: if inCall(id);
      }
    }
  
    // ---- Family: shared budgets & goals (doc id = 10-char invite code) ----
    function famDoc(fid) { return /databases/$(database)/documents/families/$(fid); }
    function inFam(fid) { return signedIn() && exists(famDoc(fid)) && request.auth.uid in get(famDoc(fid)).data.members; }
    match /families/{fid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && fid.size() == 10
        && request.resource.data.keys().hasOnly(['name','owner','members','names','cur','createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && txt(request.resource.data.name, 40)
        && request.resource.data.names.keys().hasOnly([request.auth.uid]);
      allow update: if signedIn() && request.resource.data.members.size() <= 12 && (
        // owner: rename, currency, remove members, hand over ownership when leaving
        (request.auth.uid == resource.data.owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','cur','names','members','owner'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && request.resource.data.owner in request.resource.data.members
          && txt(request.resource.data.name, 40))
        // a member leaves
        || (request.auth.uid in resource.data.members && request.auth.uid != resource.data.owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','names'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]))
        // a member changes only their own display name
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]))
        // someone with the code joins (adds only themself)
        || (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','names'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && txt(request.resource.data.names[request.auth.uid], 40))
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
      match /{sub}/{id} {
        allow read, delete: if sub in ['budgets','goals','tx'] && inFam(fid);
        allow create: if sub in ['budgets','goals','tx'] && inFam(fid) && request.resource.data.by == request.auth.uid;
        allow update: if sub in ['budgets','goals'] && inFam(fid);
      }
    }
  }
}
